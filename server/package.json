{
  "name": "@pi-fleet/server",
  "version": "0.1.0",
  "description": "pi-fleet server: fleet state, probes, attention engine, API",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test --test-concurrency=1 \"test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.check.json"
  },
  "dependencies": {
    "bonjour": "^3.5.1",
    "express": "^5.1.0",
    "ssh2": "^1.16.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^25.0.0",
    "@types/ssh2": "^1.15.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0"
  }
}
